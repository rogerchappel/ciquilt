{
  "name": "ciquilt",
  "version": "0.1.0",
  "commands": [
    {
      "name": "scan-markdown",
      "command": "ciquilt scan .github/workflows --format markdown",
      "purpose": "Human and agent workflow comprehension"
    },
    {
      "name": "scan-json",
      "command": "ciquilt scan .github/workflows --format json",
      "purpose": "Machine-readable workflow inventory and findings"
    },
    {
      "name": "scan-sarif",
      "command": "ciquilt scan .github/workflows --format sarif --output ciquilt.sarif.json",
      "purpose": "SARIF-lite upload or archival"
    }
  ],
  "policy": {
    "networkRequired": false,
    "safeByDefault": true,
    "writesOnlyWhenOutputPathSet": true
  }
}
